    "mint": "node --env-file=.env scripts/cctp.ts mint",
    "all": "node --env-file=.env scripts/cctp.ts all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "viem": "^2.57.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
