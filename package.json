{
  "name": "stellar-yield-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StellarYield Bridge: transferencia manual CCTP Stellar testnet -> Arbitrum Sepolia (paso 0)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "burn": "node --env-file=.env scripts/cctp.ts burn",
