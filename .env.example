# SOLO claves de prueba, de wallets nuevas creadas para este proyecto.
# NUNCA uses aqui la clave del agente de IA de ArbiAgent ni claves con fondos reales.

# Clave secreta de la cuenta Stellar testnet (empieza con S...)
STELLAR_SECRET_KEY=

# Clave privada de la wallet EVM que paga el gas del mint en Arbitrum Sepolia (0x...)
EVM_PRIVATE_KEY=

# Direccion EVM que recibira el USDC minteado en Arbitrum Sepolia.
# Si la dejas vacia se usa la direccion de EVM_PRIVATE_KEY.
RECIPIENT_EVM_ADDRESS=

# Monto a transferir, en USDC (por defecto 1)
AMOUNT_USDC=1

# Parametros CCTP (valores del quickstart de Circle). Cambia FINALITY a 2000 para Standard.
MAX_FEE=100000
MIN_FINALITY_THRESHOLD=1000
